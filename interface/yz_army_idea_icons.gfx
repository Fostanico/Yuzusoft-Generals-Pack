spriteTypes = {
	# The related ideas use explicit GFX_idea_* picture tokens. Keeping these
	# registrations isolated prevents an error here from invalidating older GFX files.
	spriteType = {
		name = "GFX_idea_yuzu_infantry"
		texturefile = "gfx/ideas/yuzu_infantry.png"
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_idea_yuzu_artillery"
		texturefile = "gfx/ideas/yuzu_artillery.png"
		legacy_lazy_load = no
	}
