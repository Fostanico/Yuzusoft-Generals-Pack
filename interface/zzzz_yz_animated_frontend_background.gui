guiTypes = {

	# Prebuilt runtime layout; the one-off generator is intentionally not shipped.
	# Only this named background container is replaced. Other frontend GUI types
	# remain owned by vanilla or the enabled total-conversion/layout mod.
	containerWindowType = {
		name ="frontend_background"
		position = { x=0 y=0 }
		size = {
			width = 1920
			height = 1440
			min = { width = 100% height = 100% }
			max = { width = 100% height = 10000 }
			preserve_aspect_ratio = yes
		}
		Orientation = center
		Origo = center
		clipping = no

		# The frontend controller requires background element 0. The opaque animated
		# strips render above it, while this fallback follows the active layout mod.
		background = {
			name = "Background"
			quadTextureSprite = "GFX_frontend_bg"
			alwaystransparent = yes
		}

		containerWindowType = {
			name = "yz_animated_frontend_tile_1"
