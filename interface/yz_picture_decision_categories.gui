guiTypes = {
    # The decision category's built-in description renderer does not reserve
    # space for arbitrary picture sizes. These windows own both image and text.
    containerWindowType = {
        name = "yz_roka_koharu_category_window"
        position = { x = 0 y = -15 }
        size = { width = 500 height = 200 }
        clipping = no

        background = {
            name = "yz_roka_koharu_category_background"
            quadTextureSprite = "GFX_yz_roka_koharu_category_bg_brightness_50"
            position = { x = 5 y = -18 }
        }
        # The aligned strips cover the static fallback while preserving the
        # category's existing centred text layout.
        iconType = {
            name = "yz_roka_koharu_category_background_left"
            spriteType = "GFX_yz_animated_roka_koharu_category_left"
            position = { x = 5 y = -18 }
            alwaystransparent = yes
        }
        iconType = {
            name = "yz_roka_koharu_category_background_right"
            spriteType = "GFX_yz_animated_roka_koharu_category_right"
            position = { x = 257 y = -18 }
            alwaystransparent = yes
        }
        instantTextBoxType = {
            name = "yz_roka_koharu_category_text"
            position = { x = 15 y = 0 }
            font = "hoi_16mbs"
            text = "Roka_Koharu_decision_category_gui_desc"
            maxWidth = 470
            maxHeight = 200
            format = center
            vertical_alignment = center
            fixedsize = yes
            alwaystransparent = yes
        }
    }

